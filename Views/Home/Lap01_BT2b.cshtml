@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title></title>
</head>
<body>
    <h1>Bài 2: Cho bảng sau, sử dụng thuộc tính colspan và rowspan của thẻ (table) để thực hiện các yêu cầu sau.</h1>
    <table border="5" cellpadding="20" cellspacing="10" width="600" height="400">
        <tr>
            <th colspan="2">1</th>
            <th colspan="3">2</th>
            <th>5</th>
        </tr>
        <tr>
            <td>6</td>
            <td>7</td>
            <td>8</td>
            <td rowspan="3" colspan="2">9</td>
        </tr>
        <tr>
            <td>11</td>
            <td>12</td>
            <td>13</td>
        </tr>
        <tr>
            <td>16</td>
            <td>17</td>
            <td rowspan="2">18</td>
            <td>20</td>
        </tr>
        <tr>
            <td>21</td>
            <td>22</td>
            <td>24</td>
            <td>25</td>
        </tr>
    </table>
</body>
</html>
